---
/**
 * VocaSync AudioPlayer.
 *
 * Markup only. Playback, highlighting and the view-transition lifecycle live in
 * `@vocasync/astro/player-core`, which the hoisted script below installs once per page.
 *
 * @example
 * ```astro
 * <AudioPlayer
 *   slug={post.slug}
 *   variant="minimal"
 *   controls={["play", "progress", "speed"]}
 *   strings={{ play: "Lire", pause: "Pause" }}
 * />
 * ```
 */
import { defaultStrings } from "../player-core/strings.js";
import type { AudioPlayerProps } from "./types.js";
import { DEFAULT_CONTROLS } from "./types.js";

const {
  slug,
  audioEntry,
  variant = "bar",
  size = "md",
  controls = DEFAULT_CONTROLS,
  speeds = [0.5, 0.75, 1, 1.25, 1.5, 2],
  strings = {},
  articleSelector = "[data-article-body]",
  highlight = {},
  dock = {},
  autoScroll = "off",
  exclusive = true,
  showPlaceholder = true,
  class: className = "",
  id,
} = Astro.props as AudioPlayerProps;

const s = { ...defaultStrings, ...strings };

const { enabled: highlightEnabled = true, trailLength = 4, clickToSeek = true } = highlight;
const { enabled: dockEnabled = true } = dock;

const playerId = id ?? `vocasync-player-${slug.replace(/[^a-z0-9]/gi, "-")}`;

// One config object rather than a scatter of data-* attributes. It also carries the
// audio payload: attribute-escaping JSON inflates it ~1.6x, since every `"` becomes
// `&quot;`. Only `<` needs neutralising inside a JSON script tag.
const config = {
  audio: audioEntry
    ? {
        audioUrl: audioEntry.audioUrl,
        words: audioEntry.words ?? [],
        duration: audioEntry.duration,
        publishableKey: audioEntry.synthesisPublishableKey,
      }
    : null,
  options: {
    articleSelector,
    trailLength,
    highlighting: highlightEnabled,
    clickToSeek,
    autoScroll,
    dock: dockEnabled,
    exclusive,
  },
  strings: {
    play: s.play,
    pause: s.pause,
    mute: s.mute,
    unmute: s.unmute,
    highlightOn: s.highlightOn,
    highlightOff: s.highlightOff,
  },
};
const configJson = JSON.stringify(config).replace(/</g, "\\u003c");
---

<div
  class:list={["vocasync-player", className]}
  id={playerId}
  data-slug={slug}
  data-variant={variant}
  data-size={size}
  role="group"
  aria-label={s.label}
  tabindex="0"
>
  <audio preload="metadata"></audio>
  <script type="application/json" class="vocasync-data" set:html={configJson} />

  <slot name="before" />

  <div class="vocasync-player__loading" data-state="loading">
    <div class="vocasync-player__spinner"></div>
    <span>{s.loading}</span>
  </div>

  <div class="vocasync-player__placeholder" data-state="no-audio" hidden>
    <slot name="placeholder">
      {showPlaceholder && (
        <span class="vocasync-player__placeholder-text">{s.unavailable}</span>
      )}
    </slot>
  </div>

  <div class="vocasync-player__error" data-state="error" hidden>
    <slot name="error">
      <span class="vocasync-player__error-text">{s.error}</span>
      <button type="button" class="vocasync-player__retry-btn" data-action="retry">
        {s.retry}
      </button>
    </slot>
  </div>

  <div class="vocasync-player__controls" data-state="ready" hidden>
    {controls.map((control) => (
      <Fragment>
        {control === "play" && (
          <button
            type="button"
            class="vocasync-player__play-btn"
            aria-label={s.play}
            data-action="play-pause"
          >
            <slot name="icon-play">
              <svg class="vocasync-icon vocasync-icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6 4l15 8-15 8V4z" />
              </svg>
            </slot>
            <slot name="icon-pause">
              <svg class="vocasync-icon vocasync-icon--pause vocasync-hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
              </svg>
            </slot>
          </button>
        )}

        {control === "progress" && (
          <div class="vocasync-player__progress-section">
            <div class="vocasync-player__time">
              <span data-time="current">0:00</span>
              <span class="vocasync-player__time-sep">/</span>
              <span data-time="duration">0:00</span>
            </div>
            <input
              type="range"
              class="vocasync-player__progress"
              min="0"
              max="100"
              value="0"
              step="0.1"
              aria-label={s.seek}
              data-action="seek"
            />
          </div>
        )}

        {control === "time" && (
          <div class="vocasync-player__time">
            <span data-time="current">0:00</span>
            <span class="vocasync-player__time-sep">/</span>
            <span data-time="duration">0:00</span>
          </div>
        )}

        {control === "highlight" && (
          <button
            type="button"
            class="vocasync-player__icon-btn"
            aria-label={s.highlightOn}
            data-action="toggle-highlighting"
            data-highlighting="on"
          >
            <slot name="icon-highlight-on">
              <svg class="vocasync-icon vocasync-icon--highlight-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v18" />
                <rect x="4" y="8" width="16" height="8" rx="1" fill="currentColor" opacity="0.3" />
                <path d="M8 12h8" />
              </svg>
            </slot>
            <slot name="icon-highlight-off">
              <svg class="vocasync-icon vocasync-icon--highlight-off vocasync-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v18" opacity="0.3" />
                <rect x="4" y="8" width="16" height="8" rx="1" opacity="0.3" />
                <path d="M4 4l16 16" />
              </svg>
            </slot>
          </button>
        )}

        {control === "speed" && (
          <div class="vocasync-player__speed">
            <button
              type="button"
              class="vocasync-player__speed-btn"
              aria-label={s.speed}
              aria-haspopup="menu"
              aria-expanded="false"
              data-action="speed"
            >
              <span data-speed-label>{s.speedValue(1)}</span>
            </button>
            <div class="vocasync-player__speed-menu" role="menu" hidden>
              {speeds.map((rate) => (
                <button
                  type="button"
                  role="menuitemradio"
                  aria-checked={rate === 1 ? "true" : "false"}
                  data-speed={String(rate)}
                  {...(rate === 1 ? { "data-active": "" } : {})}
                >
                  {s.speedValue(rate)}
                </button>
              ))}
            </div>
          </div>
        )}

        {control === "volume" && (
          <div class="vocasync-player__volume">
            <button type="button" class="vocasync-player__icon-btn" aria-label={s.mute} data-action="mute">
              <slot name="icon-volume">
                <svg class="vocasync-icon vocasync-icon--volume-high" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" />
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                </svg>
              </slot>
              <slot name="icon-muted">
                <svg class="vocasync-icon vocasync-icon--volume-mute vocasync-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" opacity="0.5" />
                  <line x1="23" y1="9" x2="17" y2="15" />
                  <line x1="17" y1="9" x2="23" y2="15" />
                </svg>
              </slot>
            </button>
            <input
              type="range"
              class="vocasync-player__volume-slider"
              min="0"
              max="100"
              value="100"
              aria-label={s.volume}
              data-action="volume"
            />
          </div>
        )}
      </Fragment>
    ))}
  </div>

  <slot name="after" />

  {dockEnabled && (
    <div class="vocasync-mini-player" data-mini-player role="group" aria-label={s.label} hidden>
      <button type="button" class="vocasync-mini-player__play-btn" aria-label={s.play} data-action="play-pause">
        <svg class="vocasync-icon vocasync-icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 4l15 8-15 8V4z" />
        </svg>
        <svg class="vocasync-icon vocasync-icon--pause vocasync-hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
        </svg>
      </button>
      <div class="vocasync-mini-player__progress">
        <div class="vocasync-mini-player__progress-bar" data-progress></div>
      </div>
      <span class="vocasync-mini-player__time" data-time="current">0:00</span>
      <button type="button" class="vocasync-mini-player__close-btn" aria-label={s.retry} data-action="close-mini">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
        </svg>
      </button>
    </div>
  )}
</div>

<script>
  // A hoisted module script: bundled once per page by Vite, typechecked, and shared by
  // every player on the page. `define:vars` inlined ~530 lines per instance and could
  // not be checked at all.
  import { install } from "../player-core/index.js";

  install();
</script>
